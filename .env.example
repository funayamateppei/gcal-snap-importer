VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google API Key (Calendar API のバッチリクエストで必要な場合があります)
# VITE_GOOGLE_API_KEY=your-google-api-key

# Gemini モデル名（オプション）
# デフォルト: gemini-2.0-flash-thinking-exp-01-21（推論機能により複雑な表の解析精度が向上）
# その他の選択肢:
#   - gemini-1.5-flash（高速、無料枠で利用可能）
#   - gemini-1.5-pro（高精度、無料枠で利用可能だが制限あり）
# VITE_GEMINI_MODEL=gemini-2.0-flash-thinking-exp-01-21

# 開発用: モックデータを使用する場合は true に設定（トークン消費を抑えるため）
# npm run dev:local を使用すると自動的に true になります
# VITE_USE_MOCK_DATA=true
