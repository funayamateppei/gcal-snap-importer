VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google API Key (Calendar API のバッチリクエストで必要な場合があります)
# VITE_GOOGLE_API_KEY=your-google-api-key

# Gemini モデル名（オプション）
# デフォルト: gemini-2.5-flash（価格性能比が最も優れたモデル、無料枠で利用可能）
# その他の無料枠で利用可能な選択肢:
#   - gemini-3-flash-preview（最新モデル、推論機能を含む）
#   - gemini-2.0-flash（安定版、高速）
#   - gemini-2.5-flash-lite（最速、コスト効率重視）
# VITE_GEMINI_MODEL=gemini-2.5-flash

# 開発用: モックデータを使用する場合は true に設定（トークン消費を抑えるため）
# npm run dev:local を使用すると自動的に true になります
# VITE_USE_MOCK_DATA=true
