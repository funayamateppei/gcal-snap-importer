VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google API Key (Calendar API のバッチリクエストで必要な場合があります)
# VITE_GOOGLE_API_KEY=your-google-api-key

# Gemini モデル名（オプション）
# デフォルト: gemini-3-flash（最新モデル、無料枠: 5リクエスト/分、50-100リクエスト/日）
# その他の選択肢:
#   - gemini-2.5-flash（安定版、15リクエスト/分の無料枠）
#   - gemini-2.5-pro（高性能、限定的な無料枠）
#   - gemini-3-pro（最高性能、無料枠なし・有料のみ）
# VITE_GEMINI_MODEL=gemini-3-flash

# 開発用: モックデータを使用する場合は true に設定（トークン消費を抑えるため）
# npm run dev:local を使用すると自動的に true になります
# VITE_USE_MOCK_DATA=true
